# ============================================================
#  RAG Training Bot — Environment Configuration
#  Copy this file to ".env" and fill in your values:
#     cp .env.example .env
# ============================================================

# --- REQUIRED: Google Gemini API key ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- REQUIRED: JWT signing secret (use a long random string) ---
# Generate one with:  openssl rand -hex 32
SECRET_KEY=please-change-this-to-a-long-random-secret

# --- Gemini model selection (defaults shown) ---
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Default admin user (created automatically on first launch) ---
# IMPORTANT: change the password after first login!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# --- Host port the web app is exposed on ---
APP_PORT=8080
